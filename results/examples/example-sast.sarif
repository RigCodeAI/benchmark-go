{
  "$schema": "https://json.schemastore.org/sarif-2.1.0.json",
  "version": "2.1.0",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "ExampleSAST",
          "semanticVersion": "1.0.0",
          "informationUri": "https://example.com/example-sast"
        }
      },
      "results": [
        {
          "ruleId": "EXAMPLE/CWE-89",
          "message": {"text": "Example SQL injection result"},
          "properties": {
            "cwe": "CWE-89",
            "route": "/qualification/cwe-89/vulnerable"
          }
        },
        {
          "ruleId": "EXAMPLE/CWE-79",
          "message": {"text": "Example cross-site scripting result"},
          "properties": {
            "cwe": "CWE-79",
            "route": "/qualification/cwe-79/vulnerable"
          }
        },
        {
          "ruleId": "EXAMPLE/GO-GOROUTINE-LEAK",
          "message": {
            "text": "Example goroutine leak result"
          },
          "properties": {
            "category": "GO-GOROUTINE-LEAK",
            "route": "/qualification/go-goroutine-leak/vulnerable"
          }
        }
      ]
    }
  ]
}
